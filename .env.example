DISCORD_TOKEN=
DATA_DIR=./data
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

############
# Optional #
############

# CACHE_LIMIT=2GB

# ENABLE_SPONSORBLOCK=true
# SPONSORBLOCK_TIMEOUT=5    # Delay (in mn) before retrying when SponsorBlock server are unreachable.
# YT_DLP_PATH=yt-dlp
# YT_DLP_AUTO_UPDATE=true

# See the README for details on the below variables
# BOT_STATUS=
# BOT_ACTIVITY_TYPE=
# BOT_ACTIVITY_URL=
# BOT_ACTIVITY=

# Web dashboard
# WEB_PASSWORD=
# WEB_PORT=4000
# Set only when the dashboard sits behind a reverse proxy, otherwise the login
# rate limiter counts every request against the proxy's own IP. A number is the
# hop count, e.g. 1 for a single nginx or Traefik in front.
# WEB_TRUST_PROXY=1
# DISABLE_WEB_ANNOUNCEMENTS=true
